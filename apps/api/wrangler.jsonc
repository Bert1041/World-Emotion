{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "world-emotion-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "world-emotion",
      // Local only until Phase 6 creates the real database (then: its id here).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  // docs/design/phase-5-api.md §4. Approximate and per Cloudflare location, by design.
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "DEVICE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    // Exact-match list, comma separated. The real domain is added in Phase 6.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173"
  }
}
