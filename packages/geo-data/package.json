{
  "name": "@world-emotion/geo-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./world-110m.topo.json": "./data/world-110m.topo.json",
    "./world-50m.topo.json": "./data/world-50m.topo.json"
  },
  "scripts": {
